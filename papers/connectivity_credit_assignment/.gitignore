# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# Hydra / run outputs
outputs/
.hydra/

# Downloaded run exports and their caches. These are regenerated by the
# sweeps, or downloaded from the archive linked in the README.
analysis/data/*
!analysis/data/.gitkeep

# MNIST is downloaded on first run.
/tmp/data/

# Figures. The repository root ignores *.pdf, *.png and *.svg globally, so the
# published figures have to be re-included explicitly -- they are the reference
# a regeneration is checked against, and shipping the repo without them would
# make `figures/paper/` an empty promise. Nested rules win over the root's.
!figures/paper/**
!figures/paper/*.pdf

# figures/generated/ stays ignored: it is output, rewritten on every re-run.
figures/generated/

# Local editor state
.vscode/
.idea/
